# Chạy realtime_test: bắt buộc UUID chuyến đang IN_PROGRESS (từ app tài xế / backend)
CURRENT_TRIP_ID=

# Trùng với backend MASTER_DEVICE_API_KEY
MASTER_DEVICE_API_KEY=
SMARTDRIVE_DEVICE_INGEST_URL=

# US_10 / US_16 — violation_simulator.py: có thể `python violation_simulator.py <trip_uuid>` ghi đè CURRENT_TRIP_ID
SMARTDRIVE_DEVICE_VIOLATION_JSON_URL=http://localhost:3000/api/device/violation

# US_19 — smartdrive_edge_ai.py (webcam + MediaPipe + queue)
# EDGE_CAMERA_INDEX=0
# EDGE_EAR_THRESHOLD=0.25
# EDGE_DROWSY_HOLD_SEC=1.2
# EDGE_POSE_DEG_THRESHOLD=30
# EDGE_DISTRACTED_HOLD_SEC=1.0
# EDGE_ALARM_VOLUME=1.0
# EDGE_AUDIO_RECOVERY_HOLD_SEC=0.35
# Âm thanh: mặc định .wav; có thể dùng .mp3/.ogg cùng tên gốc (vd. alarm_drowsy.mp3) — code tự tìm.
# EDGE_ALARM_DROWSY_WAV=alarm_drowsy.wav
# EDGE_ALARM_DISTRACTED_WAV=alarm_distracted.wav
# EDGE_NETWORK_QUEUE_MAX=64
# EDGE_NETWORK_MAX_RETRIES=25
# EDGE_DEFAULT_LAT=16.04
# EDGE_DEFAULT_LNG=108.25
# EDGE_AUDIO_SAMPLE_RATE=44100
# EDGE_SYNC_INTERVAL_SEC=2.0
# EDGE_SYNC_BATCH_SIZE=6
# Debug HUD: in Pitch/Yaw, max(|pitch|,|yaw|), ngưỡng, pose_ok/ACTIVE (local test). Tắt: 0 hoặc xoá dòng.
EDGE_DEBUG_POSE=1

# US_21 — SQLite + thư mục cache (smartdrive_edge_ai.py)
# PERSISTENCE_DB_PATH=database/violation_queue.db
# PERSISTENCE_CACHE_DIR=cache
# PERSISTENCE_MAX_CACHE_BYTES=524288000
# PERSISTENCE_MAX_PENDING_WARN=5000
# Giới hạn số bản ghi chưa sync (0 = tắt). Vượt ngưỡng → mặc định CHỈ cảnh báo log (US_21).
# PERSISTENCE_MAX_PENDING_RECORDS=300
# Chỉ khi chấp nhận mất bản ghi chưa ACK khi đầy ổ / vượt cap: bật evict FIFO pending (0=mặc định an toàn).
# PERSISTENCE_EVICT_PENDING_ON_PRESSURE=0

SMARTDRIVE_DEVICE_GPS_URL=http://localhost:3000/api/device/gps

GPS_SIM_STEP_SEC_MIN=2.0
GPS_SIM_STEP_SEC_MAX=3.0
GPS_SIM_ROUTE_MODE=pingpong

EYE_MODEL_HIGH_MEANS_OPEN=0
EYE_OPEN_THRESHOLD=0.5
